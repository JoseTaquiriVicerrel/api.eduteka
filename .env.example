# === API JSON (src/server.js) ===============================================
NODE_ENV=development
PORT=3000
# Interfaz en la que escucha. Tras Nginx en el mismo servidor: 127.0.0.1. Vacia = todas.
LISTEN_HOST=

# Base de datos (la misma del monolito). La API NO crea indices en ella.
MONGODB_URI=

# Redis (el mismo del monolito). Sin Redis la API arranca con un cliente en
# memoria: valido en desarrollo, no en produccion (limites y enfriamientos no se
# comparten entre instancias). Las claves de la API llevan el prefijo "api:".
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# Firma de los tokens de la API. >= 32 caracteres, DISTINTO de JWT_PRIVATE_KEY
# (que firma la cookie de sesion del monolito). Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Opcional: secreto propio para los tokens de restablecimiento (por defecto JWT_SECRET).
JWT_RESET_SECRET=
ACCESS_TTL_SECONDS=1800
REFRESH_TTL_DAYS=60
RESET_TTL_SECONDS=900
# Tras rotar un refresh token, el anterior sigue valiendo estos segundos para su dueño
# (varias peticiones con 401 refrescando a la vez). 0 = reuso estricto.
REFRESH_GRACE_SECONDS=30

# Codigos de verificacion / recuperacion
VERIFY_CODE_TTL_MINUTES=15
RECOVERY_CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_COOLDOWN_SECONDS=60
# Fallos de login por correo + IP antes de bloquear, y por correo en total (ataque repartido entre IP).
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_EMAIL=30
LOGIN_FAILURE_WINDOW_SECONDS=900
BCRYPT_ROUNDS=12

# Respuestas NUEVAS por dia (hora de Lima) sin suscripcion activa. 0 = sin limite.
FREE_DAILY_ANSWER_LIMIT=0
# Preguntas que ve de un examen quien no tiene suscripcion (vista previa). 0 = examen completo.
EXAM_PREVIEW_QUESTIONS=0
# true = el solucionario de un simulacro exige suscripcion tambien a estudiantes (la web hoy no).
SOLUCIONARIO_REQUIRES_PLAN=false
# Segundos de holgura para guardar la ultima respuesta de un simulacro tras end_exam.
SIMULACRUM_ANSWER_GRACE_SECONDS=5

# Rate limit (peticiones por ventana; ver src/middlewares/rate_limit.js).
# OJO con RATE_LIMIT_GLOBAL: muchas operadoras moviles comparten una IP entre
# miles de usuarios (CGNAT).
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_EMAIL=5
RATE_LIMIT_WRITE=60

# Proxy inverso: direcciones de confianza ("loopback" = Nginx y Next en este servidor;
# "loopback, 10.0.0.5" si Next esta en otro), nº de saltos o "true"/"false".
# Sin esto, req.ip es la IP del proxy y el rate limit por IP se vuelve global.
# En produccion: loopback (ver docs/deploy.md, seccion 4).
TRUST_PROXY=false
LOG_LEVEL=info

# CORS (la app nativa no envia Origin). Lista separada por comas.
API_CORS_ORIGINS=

# Secreto del cliente web (servidor de Next). >= 32 caracteres, distinto de JWT_SECRET
# y JWT_PRIVATE_KEY. Vacio = modo web apagado. En eduteka/web va como EDK_WEB_CLIENT_SECRET.
WEB_CLIENT_SECRET=
# Puente de sesion de la web (POST /auth/web-exchange): URL INTERNA del monolito, nunca la
# publica (p. ej. http://127.0.0.1:3000). Vacio = puente apagado (el endpoint responde 404).
# Requiere TRUST_PROXY con Nginx y la direccion de Next (el limite auth es por IP).
MONOLITH_URL=
# Vida (s) del access token que emite el puente, 60-1800. Sin refresh: la web lo vuelve a pedir.
WEB_BRIDGE_TTL_SECONDS=900

# Contrato con la app (GET /api/v1/config)
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
# Enlace directo (https) al APK de la ultima version; solo para quien instalo fuera de Google Play
APP_UPDATE_URL=
APP_PAYMENTS_ENABLED=true
APP_MAINTENANCE=false
SUPPORT_WHATSAPP=
PUBLIC_WEB_URL=https://eduteka.pe
# Yape/Plin en GET /config (sin numero, el metodo no se envia)
PAYMENT_YAPE_NUMBER=
PAYMENT_YAPE_HOLDER=
PAYMENT_YAPE_QR_URL=
PAYMENT_PLIN_NUMBER=
PAYMENT_PLIN_HOLDER=
PAYMENT_PLIN_QR_URL=
# URL publica de ESTA API (con esquema). Los avatares se guardan como URL absoluta con ella;
# sin ella quedan relativos a la API.
PUBLIC_API_URL=
# Archivos propios de la API (avatares). Fuera de cualquier raiz estatica.
STORAGE_DIR=./storage
# Comprobantes de pago de simulacros. Para que el panel del monolito los vea, apuntarlo a
# su carpeta src/public/protected/pay_capture.
PAY_CAPTURE_DIR=
# Raiz contra la que se resuelven las rutas de archivos de la base (files[].path, p. ej.
# "storage/examenes/x.pdf"). En el monolito es su carpeta src. Por defecto, la carpeta que
# contiene a STORAGE_DIR.
FILES_ROOT_DIR=
# Aviso interno cuando llega un comprobante por verificar.
ADMIN_EMAIL=
# Verificacion de comprobantes con IA (como la web). Sin clave, todo pasa a revision manual.
GEMINI_API_KEY=
# gemini | none (por defecto: gemini si hay clave)
PAYMENT_AI_PROVIDER=
PAYMENT_AI_MODEL=gemini-2.5-flash
PAYMENT_AI_TIMEOUT_MS=20000
# Dias de antiguedad maxima de la fecha del comprobante para aprobarlo solo
PAYMENT_VOUCHER_MAX_AGE_DAYS=3
# Exige que el destinatario del comprobante sea el titular (PAYMENT_*_HOLDER) o el numero
# (PAYMENT_*_NUMBER) de Yape/Plin: un comprobante real pagado a OTRA persona no se aprueba solo.
# Sin titular ni numero configurados no hay contra que comparar y no se exige.
PAYMENT_REQUIRE_RECEIVER_MATCH=true
# Importe (S/) por encima del cual el pago NUNCA se aprueba solo (revision manual). 0 = sin limite.
PAYMENT_AUTO_APPROVE_MAX_AMOUNT=0

# Correo. MAIL_PROVIDER = resend | smtp | console (solo desarrollo).
# Por defecto: resend si hay RESEND_API_KEY; si no, smtp si hay SMTP_HOST.
MAIL_PROVIDER=
MAIL_FROM=Eduteka <no-reply@eduteka.site>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# === Tiempo real de simulacros (Socket.IO) ==================================
# REALTIME_ENABLED=false apaga el socket sin tocar codigo. El monolito avisa por el canal Redis
# edk:simulacrum:events; sin Redis la API sigue funcionando (los clientes consultan cada 30 s).
REALTIME_ENABLED=true
# Precalienta las formulas SVG de un examen/simulacro cuando el monolito avisa (canal edk:content:events).
MATH_PREWARM_ENABLED=true
REALTIME_PATH=/api/v1/realtime
REALTIME_MAX_CONNECTIONS_PER_USER=5

# === Punto de entrada antiguo (api.eduteka.js) y libs copiadas del monolito ====
GOOGLE_APPLICATION_CREDENTIALS=
MONGODB_NAME=
JWT_PRIVATE_KEY=
EMAIL_SMTP=
EMAIL_PORT=
EMAIL=
EMAIL_PASSWORD=
SECRET_KEY=
