<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><title>{{#if verified}}Pedido verificado automáticamente{{else}}Nuevo pedido por verificar{{/if}}</title></head>
<body style="font-family:Arial,Helvetica,sans-serif;color:#1f2933;padding:24px;">
  <h2 style="margin:0 0 12px;">{{#if verified}}Pedido verificado automáticamente{{else}}Nuevo pedido por verificar{{/if}}</h2>
  <p>Cliente: {{email}}</p>
  <p>Total esperado: <strong>S/ {{total}}</strong> ({{payment_method}})</p>
  <ul>
  {{#each items}}
    <li>{{name}}{{#if areas}} — áreas: {{areas}}{{/if}}</li>
  {{/each}}
  </ul>
  {{#if verified}}
  <p>Estado: <strong>verificado por IA</strong> (número de operación, monto y fecha). El cliente ya puede descargar sus archivos.</p>
  {{else}}
  <p>Estado: <strong>pendiente de verificación</strong>. Revisa el comprobante en el panel de pedidos.</p>
  {{#if reason}}<p>Motivo de la revisión manual: {{reason}}</p>{{/if}}
  {{/if}}
  <p style="color:#616e7c;font-size:12px;">Pedido {{order_id}} (registrado desde la app)</p>
</body>
</html>
