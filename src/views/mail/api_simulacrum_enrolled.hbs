<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Inscripción recibida</title></head>
<body style="margin:0;padding:24px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td align="center">
    <table role="presentation" width="480" cellspacing="0" cellpadding="0" style="max-width:480px;background:#ffffff;border-radius:8px;padding:32px;"><tr><td>
      <h1 style="margin:0 0 16px;font-size:22px;">Recibimos tu inscripción</h1>
      <p style="margin:0 0 16px;line-height:1.5;">Hola{{#if username}} {{username}}{{/if}}, te inscribiste al simulacro <strong>{{title}}</strong>.</p>
      {{#if verified}}
      <p style="margin:0;line-height:1.5;">Tu pago fue verificado. Ya puedes rendirlo desde la app.</p>
      {{else}}
      <p style="margin:0;line-height:1.5;">Estamos revisando tu comprobante de pago. Te avisaremos cuando quede verificado; hasta entonces no podrás iniciar el simulacro.</p>
      {{/if}}
    </td></tr></table>
  </td></tr></table>
</body>
</html>
