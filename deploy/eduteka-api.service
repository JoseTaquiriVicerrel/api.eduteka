# Unidad systemd de la API. Copiar a /etc/systemd/system/eduteka-api.service y ajustar las rutas.
#
#   sudo cp deploy/eduteka-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eduteka-api
#   journalctl -u eduteka-api -f            # logs (JSON, una linea por evento)
#
# Un solo proceso basta: el rate limit y los bloqueos viven en Redis, no en la memoria del proceso.

[Unit]
Description=Eduteka API (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eduteka
Group=eduteka
WorkingDirectory=/opt/eduteka/api
# Variables de produccion (ver .env.example). Permisos 600, dueño eduteka.
EnvironmentFile=/opt/eduteka/api/.env
Environment=NODE_ENV=production
# Con nvm/fnm la ruta de node es otra: `which node` con el usuario eduteka.
ExecStart=/usr/bin/node src/server.js

# La API se apaga ordenadamente con SIGTERM (cierra HTTP, Mongo y Redis; fuerza la salida a los 10 s).
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=5
# Si falla 5 veces en 2 minutos no insiste para siempre: systemd la deja en "failed" y se nota.
StartLimitIntervalSec=120
StartLimitBurst=5

LimitNOFILE=65535

# --- Endurecimiento: el proceso solo escribe donde debe -----------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Rutas con escritura: STORAGE_DIR (avatares, cache de formulas), PAY_CAPTURE_DIR (comprobantes de
# simulacros) y FILES_ROOT_DIR/storage/payment (comprobantes de pedidos y suscripciones). Ajustar
# a los valores reales del .env; el resto del disco queda de solo lectura para la API.
ReadWritePaths=/opt/eduteka/api/storage /var/lib/eduteka

[Install]
WantedBy=multi-user.target
