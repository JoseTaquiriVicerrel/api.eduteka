# Unidad systemd de la API. Copiar a /etc/systemd/system/eduteka-api.service y ajustar las rutas.
#
#   sudo cp deploy/eduteka-api.service /etc/systemd/system/    (ver docs/deploy.md: despliegue continuo)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eduteka-api
#   journalctl -u eduteka-api -f            # logs (JSON, una linea por evento)
#
# Un solo proceso basta: el rate limit y los bloqueos viven en Redis, no en la memoria del proceso.

[Unit]
Description=Eduteka API (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eduteka
Group=eduteka
# `current` es un enlace simbolico a la version activa (lo cambia deploy/release.sh en cada despliegue).
WorkingDirectory=/opt/eduteka/current
# Variables de produccion (ver .env.example). Fuera del codigo, para que sobrevivan a los despliegues.
EnvironmentFile=/opt/eduteka/shared/.env
Environment=NODE_ENV=production
# Con nvm/fnm la ruta de node es otra: `which node` con el usuario eduteka.
ExecStart=/usr/bin/node src/server.js

# La API se apaga ordenadamente con SIGTERM (cierra HTTP, Mongo y Redis; fuerza la salida a los 10 s).
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=5
# Si falla 5 veces en 2 minutos no insiste para siempre: systemd la deja en "failed" y se nota.
StartLimitIntervalSec=120
StartLimitBurst=5

LimitNOFILE=65535

# --- Endurecimiento: el proceso solo escribe donde debe -----------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Los datos viven FUERA de las versiones, en /var/lib/eduteka, para que un despliegue no los toque:
#   STORAGE_DIR=/var/lib/eduteka/storage   PAY_CAPTURE_DIR=/var/lib/eduteka/pay_capture
# (FILES_ROOT_DIR queda en /var/lib/eduteka, el directorio que contiene a STORAGE_DIR.)
# Es lo unico donde la API puede escribir; el codigo (/opt/eduteka/releases) es de solo lectura.
ReadWritePaths=/var/lib/eduteka

[Install]
WantedBy=multi-user.target
