# /etc/sudoers.d/eduteka-deploy   (instalar con: sudo visudo -cf deploy/sudoers-deploy && sudo install -m 440 deploy/sudoers-deploy /etc/sudoers.d/eduteka-deploy)
#
# El usuario `deploy` solo puede reiniciar el servicio de la API; nada mas con privilegios.
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart eduteka-api
